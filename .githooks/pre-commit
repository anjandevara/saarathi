#!/bin/sh
# Refuse a commit made directly on the default branch.
#
# CLAUDE.md says one issue per commit and to branch before committing. That was
# prose, and prose is something you can forget; this is a check the tool runs.
#
# A detached HEAD (rebase, bisect, merge resolution) returns nothing here and is
# allowed through, so this never blocks a rebase onto main.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ]; then
  echo "pre-commit: refusing to commit directly to main." >&2
  echo "  Branch first:  git checkout -b <name>" >&2
  echo "  Deliberate one-off:  git commit --no-verify" >&2
  exit 1
fi
