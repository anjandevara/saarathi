# Settings for running tests on your own laptop, against the demo page
# shipped inside this framework (no real app needed to try things out).
#
# BASE_URL is left blank on purpose. When ENV_NAME=local, support/env.ts
# builds the file:// path to demo-app/index.html automatically, so this
# works on any machine without editing a path by hand.
ENV_NAME=local
BASE_URL=
